# =============================================================================
# AI COUNCIL MVP — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_GROUP_ID=-100123456789          # Supergroup with Forum enabled
CEO_TELEGRAM_USER_ID=123456789           # Numeric Telegram user ID

# --- PostgreSQL ---
DATABASE_URL=postgresql://council:secret@localhost:5432/ai_council

# --- AI Providers ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# --- Agent Models (configurable; never hard-code in business logic) ---
CODEX_MODEL_NORMAL=gpt-4o
CODEX_MODEL_ESCALATED=o1
CLAUDE_MODEL_NORMAL=claude-sonnet-4-6
CLAUDE_MODEL_ESCALATED=claude-opus-4-5
GEMINI_MODEL_NORMAL=gemini-1.5-pro
GEMINI_MODEL_ESCALATED=gemini-1.5-ultra

# --- Timezone ---
CEO_TIMEZONE=Asia/Ho_Chi_Minh

# --- Cost Limits (USD) ---
DEFAULT_SOFT_LIMIT_USD=2.00
DEFAULT_HARD_LIMIT_USD=5.00

# --- Worker ---
WORKER_LEASE_SECONDS=300
WORKER_HEARTBEAT_SECONDS=30
WORKER_CONCURRENCY=4

# --- Webhook ---
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_PORT=8000
WEBHOOK_SECRET=random-secret-string
